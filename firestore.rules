rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only reachable by someone who knows the household code (the {casa} segment).
    match /casas/{casa}/{coleccion}/{doc} {
      allow read, write: if casa.size() >= 16
        && coleccion in ['settings', 'tasks', 'completions'];
    }
  }
}
